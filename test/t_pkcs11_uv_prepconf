# Copyright contributors to the libzpc project
#
# Prepare the zpcpkcs11.conf key list for the PKCS#11 UV tests.
#
# Each entry maps a PKCS#11 label to the hbkzpc PEM file produced by
# t_ossl_uv_prepkey.  The same keys (p-256, p-384, p-521, ed25519, ed448)
# that the hbk-provider tests use are reused here.
#
# Env vars:
#   ZPC_KEY_DIR       directory that holds the *-hbkzpc.pem files (default: .)
#   ZPCPKCS11_CONF    output config file path (default: ./zpcpkcs11.conf)
#   V                 set to 1 for verbose TAP diagnostics

ZPC_KEY_DIR=${ZPC_KEY_DIR:-"."}
ZPCPKCS11_CONF=${ZPCPKCS11_CONF:-"./zpcpkcs11.conf"}
V=${V:-"0"}

ZPCS=( "p-256"  "p-384"  "p-521"  "ed25519" "ed448" )
ALGS=( "prime256v1" "secp384r1" "secp521r1" "ED25519" "ED448" )

tap13() {
	local rc="$1"
	local idx="$2"
	local text="$3"
	local log="$4"

	case ${rc} in
	0)
		echo "ok ${idx} - ${text}"
		if [ ${V} -eq 1 ]; then
			echo " ---"
			echo "${log}"
			echo " ---"
		fi
		;;
	77)
		echo "ok ${idx} # SKIP"
		;;
	*)
		echo "not ok ${idx} - ${text}"
		echo " ---"
		echo "${log}"
		echo " ---"
		;;
	esac

	return 0
}

write_conf() {
	local conf="$1"
	local out=""

	out+="# zpcpkcs11 key list generated by t_pkcs11_uv_prepconf"$'\n'
	out+="# $(date -u)"$'\n'

	for ((i=0; i<${#ZPCS[@]}; i++)); do
		local ZPC="${ZPCS[$i]}"
		local ALG="${ALGS[$i]}"
		local ZPC_PEM="${ZPC_KEY_DIR}/${ZPC}-hbkzpc.pem"

		[ -r "${ZPC_PEM}" ] || {
			echo "  key file not found, skipping: ${ZPC_PEM}" >&2
			continue
		}

		out+="${ZPC}=$(realpath "${ZPC_PEM}")"$'\n'
	done

	printf '%s' "${out}" > "${conf}" 2>&1
	echo "${out}"
}

main() {
	fail=0
	tc=0

	tc=$(( tc + 1 ))

	# Require at least one key file to be present.
	local found=0
	for ((i=0; i<${#ZPCS[@]}; i++)); do
		local ZPC="${ZPCS[$i]}"
		[ -r "${ZPC_KEY_DIR}/${ZPC}-hbkzpc.pem" ] && found=$(( found + 1 ))
	done

	if [ ${found} -eq 0 ]; then
		tap13 77 "${tc}" "Write zpcpkcs11.conf (no key files found)" ""
		return 0
	fi

	log=$(write_conf "${ZPCPKCS11_CONF}")
	rc="$?"
	[ ${rc} -ne 0 ] && fail=1
	tap13 "${rc}" "${tc}" "Write zpcpkcs11.conf (${found} key(s))" "${log}"

	return ${fail}
}

if [[ "$0" == "${BASH_SOURCE[0]}" ]]; then
	main
	exit $?
fi
